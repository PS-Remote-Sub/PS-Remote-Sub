<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:PSRemoteSub.App"
        xmlns:views="using:PSRemoteSub.App.Views"
        x:Class="PSRemoteSub.App.Views.SettingsWindow"
        Title="{app:Tr SettingsTitle}"
        Icon="/Assets/app.ico"
        Width="780" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Leelawadee UI, Segoe UI"
        FontSize="14">
  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#A0FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#FF8A80" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="#7BD88F" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </Window.Styles>

  <DockPanel>
  <!-- Missing OS permissions (macOS): one row each with a button to the System Settings page; empty elsewhere. -->
  <StackPanel x:Name="PermBanner" DockPanel.Dock="Top" Spacing="6" Margin="8,8,8,0" IsVisible="False" />
  <TabControl Margin="8,4,8,8">
    <!-- โปรไฟล์ -->
    <TabItem Header="{app:Tr TabProfiles}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="230,*" Margin="8,12,8,12">
          <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,24,0">
            <TextBlock Classes="hint" Text="{app:Tr ProfileListHint}" />
            <ListBox x:Name="ProfileList" Height="210" />
            <TextBlock Text="{app:Tr ProfileNameLabel}" Margin="0,4,0,0" />
            <TextBox x:Name="ProfileName" MaxLength="40" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ProfileAdd" Content="{app:Tr ProfileAdd}" />
              <Button x:Name="ProfileRename" Content="{app:Tr ProfileRename}" />
              <Button x:Name="ProfileDelete" Content="{app:Tr ProfileDelete}" />
            </StackPanel>
            <TextBlock x:Name="ProfileError" Classes="error" IsVisible="False" />
          </StackPanel>

          <Grid Grid.Column="1"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Classes="label" Text="{app:Tr SourceLangLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SourceLang" MinWidth="220" Margin="0,4" />

            <!-- โซน -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#40FFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,8">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="label" Text="{app:Tr ZoneLabel}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4">
                  <ComboBox x:Name="ZonePicker" MinWidth="180" />
                  <Button x:Name="AddZone" Content="{app:Tr AddZone}" />
                  <Button x:Name="DeleteZone" Content="{app:Tr DeleteZone}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Classes="label" Text="{app:Tr ZoneNameLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ZoneName" MaxLength="40" Margin="0,4" />

                <TextBlock Grid.Row="2" Classes="label" Text="{app:Tr PlacementLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Placement" MinWidth="220" Margin="0,4" />

                <TextBlock Grid.Row="3" Classes="label" Text="{app:Tr FilterLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="Filter" MinWidth="220" Margin="0,4" />

                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2" Margin="0,4">
                  <CheckBox x:Name="ZoneSendToWeb" Content="{app:Tr ZoneSendToWeb}" />
                  <CheckBox x:Name="ZoneLearn" Content="{app:Tr ZoneLearn}" />
                  <CheckBox x:Name="SpeakerLinesOnly" Content="{app:Tr SpeakerLinesOnly}" />
                  <TextBlock Classes="hint" TextWrapping="Wrap" Text="{app:Tr SpeakerLinesOnlyHint}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4" Margin="0,4">
                  <CheckBox x:Name="ZoneTrigger" Content="{app:Tr ZoneTrigger}" />
                  <TextBox x:Name="ZoneTriggerWords" MaxLength="200" />
                  <TextBlock Classes="hint" TextWrapping="Wrap" Text="{app:Tr ZoneTriggerHint}" />
                  <TextBlock x:Name="ZoneTriggerNoBox" Classes="error" IsVisible="False"
                             Text="{app:Tr ZoneTriggerNoBox}" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                  <TextBlock x:Name="ZoneBoxesState" VerticalAlignment="Center" />
                  <Button x:Name="EditZoneBoxes" Content="{app:Tr EditZoneBoxes}" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Grid.Row="2" Classes="label" Text="{app:Tr FontFamilyLabel}" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FontFamilyBox" MinWidth="220" MaxDropDownHeight="320" Margin="0,4" />

            <TextBlock Grid.Row="3" Classes="label" Text="{app:Tr FontSizeLabel}" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="FontSizeBox"
                           Minimum="16" Maximum="64" Increment="1" FormatString="0"
                           HorizontalAlignment="Left" Width="140" Margin="0,4" />

            <TextBlock Grid.Row="4" Classes="label" Text="{app:Tr OpacityLabel}" />
            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1"
                      SmallChange="0.05" LargeChange="0.1"
                      TickFrequency="0.05" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="1" x:Name="OpacityText" VerticalAlignment="Center"
                         MinWidth="48" TextAlignment="Right" Margin="12,0,0,0" />
            </Grid>

            <TextBlock Grid.Row="5" Classes="label" Text="{app:Tr GameTitleLabel}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="GameTitle" MaxLength="80" Margin="0,4" />

            <TextBlock Grid.Row="6" Classes="label" Text="{app:Tr LibraryLabel}" VerticalAlignment="Top" Margin="0,10,16,0" />
            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4" Margin="0,4">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="LibraryGame" MinWidth="220" />
                <Button x:Name="OpenLibraryFolder" Content="{app:Tr OpenLibraryFolder}" />
              </StackPanel>
              <TextBlock x:Name="LibraryNote" Classes="hint" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <TextBlock Grid.Row="7" Classes="label" Text="{app:Tr MinDisplayLabel}" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" x:Name="MinDisplayBox"
                           Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#"
                           HorizontalAlignment="Left" Width="140" Margin="0,4" />

          </Grid>
        </Grid>
      </ScrollViewer>
    </TabItem>

    <!-- แหล่งภาพ -->
    <TabItem Header="{app:Tr TabSource}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <views:PictureSourcePanel x:Name="SourcePanel" Margin="8,12,8,12" />
      </ScrollViewer>
    </TabItem>

    <!-- ภาษา OCR -->
    <TabItem Header="{app:Tr TabOcr}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="8,12,8,12">
          <TextBlock Classes="hint" Text="{app:Tr OcrIntro}" />
          <StackPanel x:Name="OcrRows" Spacing="6" />
          <Separator Margin="0,8" />
          <TextBlock Text="{app:Tr TargetLangLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="TargetLang" Width="140" MaxLength="12" />
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{app:Tr TargetLangHint}" />
          </StackPanel>
          <TextBlock x:Name="TargetLangError" Classes="error" IsVisible="False" Text="{app:Tr TargetLangInvalid}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- หน้าเว็บ -->
    <TabItem Header="{app:Tr TabWeb}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="8,12,8,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="WebEnabled" Content="{app:Tr WebEnable}" />
            <TextBlock x:Name="WebState" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="label" Text="{app:Tr PortLabel}" Margin="0" />
            <TextBox x:Name="Port" Width="100" MaxLength="5" />
            <Button x:Name="PortApply" Content="{app:Tr PortApply}" />
          </StackPanel>
          <TextBlock x:Name="PortError" Classes="error" IsVisible="False" Text="{app:Tr PortInvalid}" />

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="{app:Tr UrlsLabel}" TextWrapping="Wrap" />
              <StackPanel x:Name="UrlList" Spacing="4" />
              <TextBlock x:Name="NoLan" Classes="error" IsVisible="False" Text="{app:Tr NoLan}" />
              <TextBlock x:Name="WebClientsText" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Column="1" x:Name="QrFrame" IsVisible="False"
                    Background="White" CornerRadius="6" Padding="4" Margin="16,0,0,0"
                    VerticalAlignment="Top">
              <Image x:Name="QrImage" Width="176" Height="176" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
          </Grid>

          <Separator Margin="0,4" />
          <StackPanel x:Name="FirewallRow" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="FirewallState" VerticalAlignment="Center" />
            <Button x:Name="FirewallButton" Content="{app:Tr FirewallOpenButton}" IsVisible="False" />
          </StackPanel>
          <TextBlock x:Name="FirewallError" Classes="error" IsVisible="False" Text="{app:Tr FirewallFailed}" />
          <TextBlock x:Name="NetworkHintText" Classes="hint" Text="{app:Tr NetworkHint}" />
          <TextBlock x:Name="FirewallCancelHint" Classes="hint" Text="{app:Tr FirewallCancelHint}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ทีวี -->
    <TabItem x:Name="TabTv" Header="{app:Tr TabTv}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="8,12,8,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="TvEnabled" Content="{app:Tr TvEnable}" />
            <TextBlock x:Name="TvState" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="hint" Text="{app:Tr TvIntro}" />

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Classes="label" Text="{app:Tr TvModeLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,4">
              <RadioButton x:Name="TvModeCover" GroupName="TvMode" Content="{app:Tr TvModeCover}" />
              <RadioButton x:Name="TvModeStrip" GroupName="TvMode" Content="{app:Tr TvModeStrip}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Classes="label" Text="{app:Tr TvTextScaleLabel}" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider x:Name="TvTextScale" Minimum="50" Maximum="200"
                      SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="1" x:Name="TvTextScaleText" VerticalAlignment="Center"
                         MinWidth="48" TextAlignment="Right" Margin="12,0,0,0" />
            </Grid>

            <TextBlock Grid.Row="2" Classes="label" Text="{app:Tr TvBoxOpacityLabel}" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider x:Name="TvBoxOpacity" Minimum="0" Maximum="1"
                      SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="1" x:Name="TvBoxOpacityText" VerticalAlignment="Center"
                         MinWidth="48" TextAlignment="Right" Margin="12,0,0,0" />
            </Grid>

            <TextBlock Grid.Row="3" x:Name="TvStripBottomLabel" Classes="label" Text="{app:Tr TvStripBottomLabel}" />
            <Grid Grid.Row="3" Grid.Column="1" x:Name="TvStripBottomRow" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider x:Name="TvStripBottom" Minimum="0" Maximum="60"
                      SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="1" x:Name="TvStripBottomText" VerticalAlignment="Center"
                         MinWidth="48" TextAlignment="Right" Margin="12,0,0,0" />
            </Grid>
          </Grid>

          <Expander Header="{app:Tr TvCalibHeader}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <CheckBox x:Name="TvCalibrating" Content="{app:Tr TvCalibrate}" />
              <TextBlock Classes="hint" Text="{app:Tr TvCalibHint}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="label" Text="{app:Tr TvCalibScaleLabel}" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
                  <Slider x:Name="TvCalibScale" Minimum="0.8" Maximum="1.2"
                          SmallChange="0.005" LargeChange="0.02" TickFrequency="0.005" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="1" x:Name="TvCalibScaleText" VerticalAlignment="Center"
                             MinWidth="56" TextAlignment="Right" Margin="12,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="1" Classes="label" Text="{app:Tr TvCalibXLabel}" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
                  <Slider x:Name="TvCalibX" Minimum="-0.1" Maximum="0.1"
                          SmallChange="0.0025" LargeChange="0.01" TickFrequency="0.0025" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="1" x:Name="TvCalibXText" VerticalAlignment="Center"
                             MinWidth="56" TextAlignment="Right" Margin="12,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="2" Classes="label" Text="{app:Tr TvCalibYLabel}" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
                  <Slider x:Name="TvCalibY" Minimum="-0.1" Maximum="0.1"
                          SmallChange="0.0025" LargeChange="0.01" TickFrequency="0.0025" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="1" x:Name="TvCalibYText" VerticalAlignment="Center"
                             MinWidth="56" TextAlignment="Right" Margin="12,0,0,0" />
                </Grid>

                <Button Grid.Row="3" Grid.Column="1" x:Name="TvCalibReset" Content="{app:Tr TvCalibReset}" Margin="0,4" />
              </Grid>
            </StackPanel>
          </Expander>

          <Separator Margin="0,4" />
          <TextBlock Classes="header" Text="{app:Tr TvInstallHeader}" />
          <TextBlock Classes="hint" Text="{app:Tr TvInstallSteps}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="label" Text="{app:Tr TvAddressLabel}" Margin="0" />
            <TextBox x:Name="TvAddress" Width="200" MaxLength="64" PlaceholderText="{app:Tr TvAddressWatermark}" />
            <!-- Not focusable: clicking it must not commit a half-typed field elsewhere. -->
            <Button x:Name="TvInstall" Content="{app:Tr TvInstallButton}" Focusable="False" />
          </StackPanel>
          <TextBlock Classes="hint" Text="{app:Tr TvAddressHint}" />
          <TextBlock x:Name="TvInstallStepText" TextWrapping="Wrap" IsVisible="False" />
          <TextBlock x:Name="TvInstallError" Classes="error" IsVisible="False" />
          <!-- macOS only: shown when LAN traffic to the TV is refused, which is what a denied Local Network permission looks like. -->
          <StackPanel x:Name="TvLocalNetworkHint" Orientation="Horizontal" Spacing="12" IsVisible="False">
            <TextBlock Text="{app:Tr PermLocalNetwork}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
            <Button x:Name="TvLocalNetworkSettings" Content="{app:Tr PermOpenSettings}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- การแปล -->
    <TabItem Header="{app:Tr TabTranslation}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="8,12,8,12">
          <TextBlock Classes="header" Text="{app:Tr TranslationModeLabel}" />
          <RadioButton x:Name="ModeGoogle" GroupName="TranslationMode" Content="{app:Tr TranslationModeGoogle}" />
          <TextBlock x:Name="GooglePrivacyText" Classes="hint" Margin="28,0,0,0" Text="{app:Tr GooglePrivacyNote}" />
          <RadioButton x:Name="ModeAi" GroupName="TranslationMode" Content="{app:Tr TranslationModeAi}" />

          <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
            <TextBlock Classes="label" x:Name="TranslationStatusLabel" Text="{app:Tr AiStatusLabel}" />
            <TextBlock Grid.Column="1" x:Name="AiStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>

          <StackPanel x:Name="AiSettingsPanel" Spacing="10">
            <TextBlock Classes="header" Text="{app:Tr TranslationAiHeader}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="{app:Tr AiProviderLabel}" />
              <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AiProviderBox" MinWidth="220" Margin="0,4" />

              <TextBlock Grid.Row="1" Classes="label" x:Name="AiKeyLabelText" Text="{app:Tr AiKeyLabel}" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="AiKey" PasswordChar="●" MaxLength="400"
                       HorizontalAlignment="Left" Width="320" Margin="0,4" />

              <TextBlock Grid.Row="2" Classes="label" Text="{app:Tr AiModelLabel}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="AiModel" Width="320" MaxLength="200" />
                  <Button x:Name="AiListModels" Content="{app:Tr AiListModels}" />
                  <ComboBox x:Name="AiModelList" MinWidth="160" MaxDropDownHeight="320" IsVisible="False" />
                </StackPanel>
                <TextBlock x:Name="AiListError" Classes="error" IsVisible="False" />
              </StackPanel>

              <TextBlock Grid.Row="3" Classes="label" Text="{app:Tr AiContextLabel}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4">
                <NumericUpDown x:Name="AiContext" Minimum="0" Maximum="10" Increment="1" FormatString="0" Width="140" />
                <TextBlock VerticalAlignment="Center" Text="{app:Tr AiContextSuffix}" />
              </StackPanel>

              <TextBlock Grid.Row="4" Classes="label" Text="{app:Tr AiQueueLabel}" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4">
                <NumericUpDown x:Name="AiQueue" Minimum="1" Maximum="30" Increment="1" FormatString="0" Width="140" />
                <TextBlock VerticalAlignment="Center" Text="{app:Tr AiQueueSuffix}" />
              </StackPanel>

              <TextBlock Grid.Row="5" Classes="label" Text="{app:Tr AiParallelLabel}" />
              <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,4">
                <NumericUpDown x:Name="AiParallel" Minimum="1" Maximum="10" Increment="1" FormatString="0" Width="140" />
                <TextBlock VerticalAlignment="Center" Text="{app:Tr AiParallelSuffix}" />
              </StackPanel>

              <!-- Not focusable: clicking it must not commit (save) a key or field that is still being typed. -->
              <Button Grid.Row="6" Grid.Column="1" x:Name="AiTest" Content="{app:Tr AiTestButton}"
                      Focusable="False" Margin="0,8,0,4" />
              <TextBlock Grid.Row="7" Grid.Column="1" x:Name="AiTestResult" TextWrapping="Wrap"
                         IsVisible="False" Margin="0,0,0,4" />
            </Grid>

            <Expander x:Name="AiAdvancedExpander" Header="{app:Tr AiAdvanced}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="label" Text="{app:Tr AiUrlLabel}" Margin="0" />
                  <TextBox x:Name="AiUrl" Width="420" MaxLength="400" />
                </StackPanel>
                <TextBlock x:Name="AiHttpWarningText" Classes="error" IsVisible="False" Text="{app:Tr AiHttpWarning}" />
              </StackPanel>
            </Expander>

            <TextBlock Classes="hint" Text="{app:Tr AiPrivacyNote}" Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ทั่วไป -->
    <TabItem Header="{app:Tr TabGeneral}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="8,12,8,12">
          <CheckBox x:Name="KeepAwake" Content="{app:Tr KeepAwakeLabel}" />
          <CheckBox x:Name="ShowRegionFrames" Content="{app:Tr RegionFramesLabel}" />

          <TextBlock Classes="header" Text="{app:Tr HotkeysHeader}" Margin="0,8,0,0" />
          <Grid x:Name="HotkeyGrid" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" />
          <TextBlock Classes="hint" Text="{app:Tr HotkeyHint}" />

          <TextBlock Classes="header" Text="{app:Tr StatusHeader}" Margin="0,8,0,0" />
          <TextBlock x:Name="StatusOverall" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusRemotePlay" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusFrames" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusTranslator" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusOcr" TextWrapping="Wrap" />

          <TextBlock x:Name="VersionText" Classes="hint" Margin="0,12,0,0" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
  </DockPanel>
</Window>
