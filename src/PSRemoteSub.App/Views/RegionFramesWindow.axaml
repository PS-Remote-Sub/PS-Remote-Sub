<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PSRemoteSub.App.Views"
        x:Class="PSRemoteSub.App.Views.RegionFramesWindow"
        Title="PS Remote Sub debug frames"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Grid>
    <views:RegionFramesCanvas x:Name="Frames" />
    <!-- The legend (built in code): what each frame colour means. Top left of the game area. -->
    <Border x:Name="Legend" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24" IsHitTestVisible="False" />
  </Grid>
</Window>
